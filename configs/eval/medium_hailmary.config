# DoRA-adapter test-set WER - whisper-medium.
# See the README ("Configuration") for how these keys map to CLI flags and
# environment variables. Values shown as <...> must be set for your environment.

fp16 = True
return_timestamps = False

output_tag = WM_hailmary_frac005

num_workers = 1
cpus_per_trial = 0
gpus_per_trial = 1
use_gpu = True
eval_batch_size = 8
prefetch_batches = 0

random_seed = 1337
resume_evaluation = True

model_type = whisper-medium
target_language = german
debug = False
run_on_local_machine = True
peft = True
h5 = True

path_to_data = <DATA_PATH>   # your data directory (or leave to fall back to $DATA_PATH)
dataset_name = eg_dataset_complete_v3

model_ckpt_path = <PATH_TO_ADAPTER_CHECKPOINT>   # best-trial checkpoint dir from your HPO run

# max_eval_batches = 5
