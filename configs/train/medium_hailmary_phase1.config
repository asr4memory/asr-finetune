# Phase-1 hail-mary LoRA/DoRA HPO configuration - whisper-medium.
# See the README ("Configuration") for how these keys map to CLI flags and
# environment variables. Values shown as <...> must be set for your environment.

resume_training = True

num_samples = 48

search_schedule_mode = large_small_OPTUNA
reduction_factor = 3
metric_to_optimize = eval_wer_diff
wer_weight = 0.8

optuna_study_name = wm_hailmary_phase1_frac005_v1
modes = min

eval_sample_fraction = 0.05
shard_schedule = deterministic

save_steps = 1000
eval_steps = 1000
logging_steps = 250

per_device_train_batch_size = 8
hyperparameters = learning_rate_lora,warmup_ratio,alpha_coupled,target_r_wide,lora_dropout
grace_period = 2400

max_steps = 4001
num_train_epochs = 1

decorr_stopper = True
decorr_loss_key = eval_loss_running
decorr_wer_key = eval_wer_running

ema_decay = 0.99
ema_start_step = 500

output_tag = WM_hailmary_phase1_frac005

num_workers = 1
cpus_per_trial = 2
gpus_per_trial = 1.0
use_gpu = True
prefetch_batches = 1
dataloader_num_workers = 1

model_type = whisper-medium
dataset_name = eq_complete_openai_whisper-small

debug = False
run_on_local_machine = True
peft = True
load_ds_in_trainer = True
data_mode = parquet

max_concurrent_trials = 2
reuse_actors = True
num_to_keep = 2

random_seed = 1337
per_device_eval_batch_size = 4
return_timestamps = False
fp16 = True
bf16 = False
