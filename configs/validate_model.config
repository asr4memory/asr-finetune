# Standalone per-shard validation configuration.
# See the README ("Configuration") for how these keys map to CLI flags and
# environment variables. Values shown as <...> must be set for your environment.

per_device_eval_batch_size = 16
fp16 = True

# model specific impact
return_timestamps = False


eval_sample_fraction = 0.05 #0.005 # splitting eval set into smaller sizes for faster training, corresponds to 1K eval set out of 20K


#####################
# CHANGEABLE SETTINGS
#####################

# Output Directory Name
output_tag = crisper-whisper #large_v3_eval


# Cluster Specific Settings: These Must Match The Requested Resources In The .BS File
num_workers = 1
cpus_per_trial = 10
gpus_per_trial = 1.0
use_gpu = True
prefetch_batches = 1

# For Reproducibility: Import To Use The Same Random Seed For Evaluation
random_seed = 1337


#####################
# Model type and debugging
#####################
model_type = CrisperWhisper # whisper-large-v3
debug = False # uses less data then provided
dataset_name = crisper_whisper_preprocessings
run_on_local_machine = True
peft = False

load_ds_in_trainer = True
data_mode = parquet
