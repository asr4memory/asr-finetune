# Dataset materialization: HDF5 corpus -> sharded Parquet Whisper features.
# See the README ("Prepare the dataset"). Run once per split (train/val/test),
# changing hdf5_path and split each time. Values shown as <...> must be set.

hdf5_path = <DATA_PATH>/eg_dataset_complete_v3_train.h5
output_path = <DATA_PATH>/eg_dataset_complete_v3_sharded
split = train_parquet
model_type = whisper-large-v3
batch_size = 32
num_shards = 100
