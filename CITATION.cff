    given-names: Peter
  - family-names: Kilgus
    given-names: Tobias
repository-code: "https://github.com/asr4memory/asr-finetune"
license: AGPL-3.0-or-later
keywords:
  - automatic speech recognition
  - Whisper
  - LoRA
  - DoRA
  - parameter-efficient fine-tuning
  - hyperparameter optimization
  - oral history
  - digital humanities
preferred-citation:
